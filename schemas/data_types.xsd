<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
	
	<xs:simpleType name="Т10">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="10"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т20">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т20П">
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т50">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т50П">
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="50"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т60">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="60"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т60П">
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="60"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т100">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="100"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т250">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="250"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т250П">
		<xs:restriction base="xs:string">
			<xs:minLength value="0"/>
			<xs:maxLength value="250"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т500">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="500"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="Т2000">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="2000"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ОГРНТип">
		<xs:annotation>
			<xs:documentation>Основной государственный регистрационный номер юридического лица</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{13}|[0-9]{15}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ИННТип">
		<xs:annotation>
			<xs:documentation>Идентификационный номер налогоплательщика</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{10}|[0-9]{12}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="КППТип">
		<xs:annotation>
			<xs:documentation>Код причины постановки на учет (КПП)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{9}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ОКСМТип">
		<xs:annotation>
			<xs:documentation>Код страны по ОКСМ</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{3}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ОКСМТипП">
		<xs:annotation>
			<xs:documentation>Код страны по ОКСМ</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{3}|"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="КодСубъектаПоОКАТОТип">
		<xs:annotation>
			<xs:documentation>Код из Справочника субъекта Российской Федерации </xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}|"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ДатаТип">
		<xs:annotation>
			<xs:documentation>Дата</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}/[0-9]{2}/[0-9]{4}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ДатаТипП">
		<xs:annotation>
			<xs:documentation>Дата</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9]{2}/[0-9]{2}/[0-9]{4})|"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ВремяТип">
		<xs:annotation>
			<xs:documentation>Время</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{2}:[0-9]{2}:[0-9]{2}"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:simpleType name="ТелефонТип">
		<xs:restriction base="xs:string">
			<xs:minLength value="1"/>
			<xs:maxLength value="250"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="ФИО">
		<xs:annotation>
			<xs:documentation>Фамилия, имя, отчество</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="Фам" type="Т100">
				<xs:annotation>
					<xs:documentation>Фамилия</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Имя" type="Т100">
				<xs:annotation>
					<xs:documentation>Имя</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Отч" minOccurs="0" type="Т100">
				<xs:annotation>
					<xs:documentation>Отчество</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	
	<xs:simpleType name="ИдентификаторЗаписи">
		<xs:annotation>
			<xs:documentation>Указывается уникальный идентификатор записи сведений, представляемых организацией (филиалом организации)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([0-9]{4}_[0-9]{3}_(01|02|11)_[0-9a-zA-Z]{16})"/>
		</xs:restriction>
	</xs:simpleType>

	<xs:complexType name="ДокУдост">
		<xs:annotation>
			<xs:documentation>
				Сведения о документе, удостоверяющем личность гражданина Российской Федерации, иностранного гражданина или лица без гражданства
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ВидДокКод">
				<xs:annotation>
					<xs:documentation>Код вида документа, удостоверяющего личность</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="2[1-8]|3[1-9]|4[0-2]|99|"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ВидДокНаименование" type="Т250П">
				<xs:annotation>
					<xs:documentation>Наименование вида документа, удостоверяющего личность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ИноеНаименованиеДок" type="Т250" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Наименование иного документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СерияДок" type="Т50П">
				<xs:annotation>
					<xs:documentation>Серия документа</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="НомДок" type="Т50П">
				<xs:annotation>
					<xs:documentation>Номер документа, удостоверяющего личность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДатВыдачиДок" type="ДатаТипП">
				<xs:annotation>
					<xs:documentation>Дата выдачи документа, удостоверяющего личность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КемВыданДок" type="Т250П">
				<xs:annotation>
					<xs:documentation>Орган, выдавший документ, удостоверяющий личность</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КодПодр" type="Т50П">
				<xs:annotation>
					<xs:documentation>Код подразделения</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ДокТекст" type="Т2000" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Сведения о документе, удостоверяющем личность (в одной строке)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="МестоРождения">
		<xs:annotation>
			<xs:documentation>Сведения о месте рождения</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="КодОКСМ" type="ОКСМТипП">
				<xs:annotation>
					<xs:documentation>Код страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СтранаНаименование" type="Т250П">
				<xs:annotation>
					<xs:documentation>Наименование страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КодСубъектаПоОКАТО" type="КодСубъектаПоОКАТОТип">
				<xs:annotation>
					<xs:documentation>Код субъекта Российской Федерации по ОКАТО</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Район" type="Т250П">
				<xs:annotation>
					<xs:documentation>Район</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Пункт" type="Т250П">
				<xs:annotation>
					<xs:documentation>Населенный пункт</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="МестоРождТекст" type="Т2000" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Место рождения (в одной строке)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="Адрес">
		<xs:sequence>
			<xs:element name="КодОКСМ" type="ОКСМТипП">
				<xs:annotation>
					<xs:documentation>Код страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СтранаНаименование" type="Т250П">
				<xs:annotation>
					<xs:documentation>Наименование страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КодСубъектаПоОКАТО" type="КодСубъектаПоОКАТОТип">
				<xs:annotation>
					<xs:documentation>Код субъекта Российской Федерации по ОКАТО</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Район" type="Т250П">
				<xs:annotation>
					<xs:documentation>Район</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Пункт" type="Т250П">
				<xs:annotation>
					<xs:documentation>Населенный пункт</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Улица" type="Т250П">
				<xs:annotation>
					<xs:documentation>Улица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дом" type="Т60П">
				<xs:annotation>
					<xs:documentation>Дом(владение)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Корп" type="Т20П">
				<xs:annotation>
					<xs:documentation>Корпус(строение)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Оф" type="Т20П">
				<xs:annotation>
					<xs:documentation>Офис (строение)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="АдресТекст" type="Т2000" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Адрес (в одной строке)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="Адрес_У">
		<xs:sequence>
			<xs:element name="КодОКСМ" type="ОКСМТипП" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Код страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="СтранаНаименование" type="Т250П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Наименование страны</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="КодСубъектаПоОКАТО" type="КодСубъектаПоОКАТОТип" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Код субъекта Российской Федерации по ОКАТО</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Район" type="Т250П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Район</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Пункт" type="Т250П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Населенный пункт</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Улица" type="Т250П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Улица</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Дом" type="Т60П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Дом(владение)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Корп" type="Т20П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Корпус(строение)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="Оф" type="Т20П" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Офис (строение)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="АдресТекст" type="Т2000" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Адрес (в одной строке)</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="СведенияЮЛ">
		<xs:annotation>
			<xs:documentation>Сведения о юридическом лице (филиале юридического лица)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="НаимЮЛ" type="Т500">
				<xs:annotation>
					<xs:documentation>Наименование юридического лица (филиала юридического лица)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ИННЮЛ">
				<xs:annotation>
					<xs:documentation>ИНН (КИО)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]{10}|[0-9]{5}|0"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="КППЮЛ" type="КППТип" minOccurs="0">
				<xs:annotation>
					<xs:documentation>КПП</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ОГРНЮЛ">
				<xs:annotation>
					<xs:documentation>ОГРН</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[\S' ']{1,50}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="АдрРегЮЛ" type="Адрес">
				<xs:annotation>
					<xs:documentation>Место государственной регистрации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="АдрЮЛ" type="Адрес" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Адрес юридического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="СведенияЮЛ_У">
		<xs:annotation>
			<xs:documentation>Сведения о юридическом лице (филиале юридического лица)</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="НаимЮЛ" type="Т500">
				<xs:annotation>
					<xs:documentation>Наименование юридического лица (филиала юридического лица)</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ИННЮЛ" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ИНН (КИО)</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]{10}|[0-9]{5}|0"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="КППЮЛ" type="КППТип" minOccurs="0">
				<xs:annotation>
					<xs:documentation>КПП</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ОГРНЮЛ" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ОГРН</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[\S' ']{1,50}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="АдрРегЮЛ" type="Адрес_У" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Место государственной регистрации</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="АдрЮЛ" type="Адрес_У" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Адрес юридического лица</xs:documentation>
				</xs:annotation>
			</xs:element>
		</xs:sequence>
	</xs:complexType>

	<xs:complexType name="СведенияФЛИП">
		<xs:annotation>
			<xs:documentation>
				Сведения о физическом лице, индивидуальном предпринимателе, физическом лице,
				занимающимся в установленном законодательством Российской Федерации порядке частной практикой
			</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element name="ФИОФЛИП" type="ФИО" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Фамилия, имя, отчество</xs:documentation>
				</xs:annotation>
			</xs:element>
			<xs:element name="ФИОСтрока" type="Т500" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Фамилия, имя, отчество (в одной строке)</xs:documentation>
				</xs:annotation>				
			</xs:element>
			<xs:element name="ИННФЛИП">
				<xs:annotation>
					<xs:documentation>ИНН</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]{12}|0|"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ОГРНИП" minOccurs="0">
				<xs:annotation>
					<xs:documentation>ОГРНИП</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="[0-9]{15}"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="ТипФЛЧастнаяПрактика" minOccurs="0">
				<xs:annotation>
					<xs:documentation>Тип физического лица, занимающегося в установленном законодательством Российской Федерации порядке частной практикой</xs:documentation>
				</xs:annotation>
				<xs:simpleType>
					<xs:restriction base="xs:string">
						<xs:pattern value="1|2"/>
					</xs:restriction>
				</xs:simpleType>
			</xs:element>
			<xs:element name="РегнНомер" type="Т50" minOccurs="0">
				<xs:annotation>
					<xs:documentation>
						Регистрационный номер, присвоенный физическому лицу, занимающемуся в установленном законодательством Российской Федерации порядке частной практикой
					</xs:documentation>
				</xs:annotation>
			</xs:element>
